# Local only. Generate your own password; never commit .env.local.
LOCAL_ADMIN_EMAIL=teacher@example.test
LOCAL_ADMIN_PASSWORD=
# Set these together for Supabase Auth. Admin role must be app_metadata.role=admin.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only PostgreSQL connection; TLS verification must remain enabled.
DATABASE_URL=
# HTTPS public application origin for phone QR codes.
PUBLIC_ORIGIN=
PORT=3000
# Explicitly allow SQLite for a local production-build smoke test only.
ALLOW_LOCAL_DEMO=
CLOUDFLARE_RELAY_URL=
RELAY_SECRET=
RETENTION_DAYS=30
POSTGRES_PASSWORD=
