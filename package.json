{
  "name": "english-brain-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "curriculum:check": "tsx scripts/curriculum.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "data:prune": "node --env-file-if-exists=.env.local --import tsx scripts/prune.ts",
    "worker:build": "mkdir -p .local/config && XDG_CONFIG_HOME=\"$PWD/.local/config\" WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config cloudflare/wrangler.toml --outdir .local/worker-build",
    "worker:check": "tsc -p cloudflare/tsconfig.json",
    "pretest": "npm run worker:build",
    "start:vercel": "next start",
    "vercel-build": "node --env-file-if-exists=.env.local --import tsx scripts/vercel-build.ts",
    "test:serverless": "tsx scripts/verify-serverless.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "next": "^16.4.1",
    "pg": "^8.16.0",
    "postcss": "^8.5.30",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "miniflare": "^5.20261012.0-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": "24.x"
  }
}
